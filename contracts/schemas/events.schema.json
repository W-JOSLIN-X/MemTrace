{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://memtrace.local/contracts/schemas/events.schema.json",
  "title": "MemTrace G0 SSE data envelope",
  "description": "Normative schema for the JSON in each SSE data field. The wire event value equals event_type. Persistent events have an integer event_seq and matching SSE id; transient events have event_seq null and omit the SSE id line.",
  "type": "object",
  "properties": {
    "event_version": {
      "type": "string",
      "const": "1.0"
    },
    "event_type": {
      "type": "string",
      "enum": [
        "task.created",
        "task.stage",
        "task.fingerprinted",
        "memory.retrieval.started",
        "memory.retrieval.completed",
        "agent.plan.published",
        "tool.called",
        "tool.result",
        "agent.chunk",
        "run.metrics",
        "run.completed",
        "run.failed",
        "error",
        "stream.done",
        "feedback.recorded",
        "memory.extraction.stage",
        "memory.candidate.created",
        "memory.admission.resolved",
        "memory.job.failed",
        "memory.injected",
        "memory.usage.verified",
        "memory.usage.feedback.recorded",
        "task.deleted",
        "memory.lifecycle.changed",
        "memory.conflict.detected",
        "memory.conflict.resolved",
        "memory.pack.previewed",
        "memory.pack.committed"
      ]
    },
    "event_seq": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1
    },
    "task_id": {
      "$ref": "#/$defs/TaskId"
    },
    "run_id": {
      "$ref": "#/$defs/RunId"
    },
    "at": {
      "$ref": "#/$defs/Timestamp"
    },
    "data": {
      "type": "object"
    }
  },
  "required": [
    "event_version",
    "event_type",
    "event_seq",
    "task_id",
    "run_id",
    "at",
    "data"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "event_type": {
            "const": "task.created"
          }
        },
        "required": [
          "event_type"
        ]
      },
      "then": {
        "properties": {
          "event_seq": {
            "type": "integer",
            "minimum": 1
          },
          "data": {
            "$ref": "#/$defs/TaskCreatedPayload"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "event_type": {
            "const": "task.stage"
          }
        },
        "required": [
          "event_type"
        ]
      },
      "then": {
        "properties": {
          "event_seq": {
            "type": "integer",
            "minimum": 1
          },
          "data": {
            "$ref": "#/$defs/TaskStagePayload"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "event_type": {
            "const": "task.fingerprinted"
          }
        },
        "required": [
          "event_type"
        ]
      },
      "then": {
        "properties": {
          "event_seq": {
            "type": "integer",
            "minimum": 1
          },
          "data": {
            "$ref": "#/$defs/TaskFingerprintedPayload"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "event_type": {
            "const": "memory.retrieval.started"
          }
        },
        "required": [
          "event_type"
        ]
      },
      "then": {
        "properties": {
          "event_seq": {
            "type": "null"
          },
          "data": {
            "$ref": "#/$defs/MemoryRetrievalStartedPayload"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "event_type": {
            "const": "agent.plan.published"
          }
        },
        "required": [
          "event_type"
        ]
      },
      "then": {
        "properties": {
          "event_seq": {
            "type": "integer",
            "minimum": 1
          },
          "data": {
            "$ref": "#/$defs/AgentPlanPublishedPayload"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "event_type": {
            "const": "tool.called"
          }
        },
        "required": [
          "event_type"
        ]
      },
      "then": {
        "properties": {
          "event_seq": {
            "type": "integer",
            "minimum": 1
          },
          "data": {
            "$ref": "#/$defs/ToolCalledPayload"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "event_type": {
            "const": "tool.result"
          }
        },
        "required": [
          "event_type"
        ]
      },
      "then": {
        "properties": {
          "event_seq": {
            "type": "integer",
            "minimum": 1
          },
          "data": {
            "$ref": "#/$defs/ToolResultPayload"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "event_type": {
            "const": "agent.chunk"
          }
        },
        "required": [
          "event_type"
        ]
      },
      "then": {
        "properties": {
          "event_seq": {
            "type": "null"
          },
          "data": {
            "$ref": "#/$defs/AgentChunkPayload"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "event_type": {
            "const": "run.metrics"
          }
        },
        "required": [
          "event_type"
        ]
      },
      "then": {
        "properties": {
          "event_seq": {
            "type": "integer",
            "minimum": 1
          },
          "data": {
            "$ref": "#/$defs/RunMetricsPayload"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "event_type": {
            "const": "run.completed"
          }
        },
        "required": [
          "event_type"
        ]
      },
      "then": {
        "properties": {
          "event_seq": {
            "type": "integer",
            "minimum": 1
          },
          "data": {
            "$ref": "#/$defs/RunCompletedPayload"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "event_type": {
            "const": "run.failed"
          }
        },
        "required": [
          "event_type"
        ]
      },
      "then": {
        "properties": {
          "event_seq": {
            "type": "integer",
            "minimum": 1
          },
          "data": {
            "$ref": "#/$defs/RunFailedPayload"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "event_type": {
            "const": "error"
          }
        },
        "required": [
          "event_type"
        ]
      },
      "then": {
        "properties": {
          "event_seq": {
            "type": "integer",
            "minimum": 1
          },
          "data": {
            "$ref": "#/$defs/ErrorPayload"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "event_type": {
            "const": "stream.done"
          }
        },
        "required": [
          "event_type"
        ]
      },
      "then": {
        "properties": {
          "event_seq": {
            "type": "integer",
            "minimum": 1
          },
          "data": {
            "$ref": "#/$defs/StreamDonePayload"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "event_type": {
            "const": "feedback.recorded"
          }
        },
        "required": [
          "event_type"
        ]
      },
      "then": {
        "properties": {
          "event_seq": {
            "type": "integer",
            "minimum": 1
          },
          "data": {
            "$ref": "#/$defs/FeedbackRecordedPayload"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "event_type": {
            "const": "memory.extraction.stage"
          }
        },
        "required": [
          "event_type"
        ]
      },
      "then": {
        "properties": {
          "event_seq": {
            "type": "integer",
            "minimum": 1
          },
          "data": {
            "$ref": "#/$defs/MemoryExtractionStagePayload"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "event_type": {
            "const": "memory.candidate.created"
          }
        },
        "required": [
          "event_type"
        ]
      },
      "then": {
        "properties": {
          "event_seq": {
            "type": "integer",
            "minimum": 1
          },
          "data": {
            "$ref": "#/$defs/MemoryCandidateCreatedPayload"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "event_type": {
            "const": "memory.admission.resolved"
          }
        },
        "required": [
          "event_type"
        ]
      },
      "then": {
        "properties": {
          "event_seq": {
            "type": "integer",
            "minimum": 1
          },
          "data": {
            "$ref": "#/$defs/MemoryAdmissionResolvedPayload"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "event_type": {
            "const": "memory.job.failed"
          }
        },
        "required": [
          "event_type"
        ]
      },
      "then": {
        "properties": {
          "event_seq": {
            "type": "integer",
            "minimum": 1
          },
          "data": {
            "$ref": "#/$defs/MemoryJobFailedPayload"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "event_type": {
            "const": "memory.retrieval.completed"
          }
        },
        "required": [
          "event_type"
        ]
      },
      "then": {
        "properties": {
          "event_seq": {
            "type": "integer",
            "minimum": 1
          },
          "data": {
            "$ref": "#/$defs/MemoryRetrievalCompletedPayload"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "event_type": {
            "const": "memory.injected"
          }
        },
        "required": [
          "event_type"
        ]
      },
      "then": {
        "properties": {
          "event_seq": {
            "type": "integer",
            "minimum": 1
          },
          "data": {
            "$ref": "#/$defs/MemoryInjectedPayload"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "event_type": {
            "const": "memory.usage.verified"
          }
        },
        "required": [
          "event_type"
        ]
      },
      "then": {
        "properties": {
          "event_seq": {
            "type": "integer",
            "minimum": 1
          },
          "data": {
            "$ref": "#/$defs/MemoryUsageVerifiedPayload"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "event_type": {
            "const": "memory.usage.feedback.recorded"
          }
        },
        "required": [
          "event_type"
        ]
      },
      "then": {
        "properties": {
          "event_seq": {
            "type": "integer",
            "minimum": 1
          },
          "data": {
            "$ref": "#/$defs/MemoryUsageFeedbackRecordedPayload"
          }
        }
      }
    },
    {"if":{"properties":{"event_type":{"const":"task.deleted"}},"required":["event_type"]},"then":{"properties":{"event_seq":{"type":"integer","minimum":1},"data":{"$ref":"#/$defs/TaskDeletedPayload"}}}},
    {"if":{"properties":{"event_type":{"const":"memory.lifecycle.changed"}},"required":["event_type"]},"then":{"properties":{"event_seq":{"type":"integer","minimum":1},"data":{"$ref":"#/$defs/MemoryLifecyclePayload"}}}},
    {"if":{"properties":{"event_type":{"const":"memory.conflict.detected"}},"required":["event_type"]},"then":{"properties":{"event_seq":{"type":"integer","minimum":1},"data":{"$ref":"#/$defs/MemoryConflictDetectedPayload"}}}},
    {"if":{"properties":{"event_type":{"const":"memory.conflict.resolved"}},"required":["event_type"]},"then":{"properties":{"event_seq":{"type":"integer","minimum":1},"data":{"$ref":"#/$defs/MemoryConflictResolvedPayload"}}}},
    {"if":{"properties":{"event_type":{"const":"memory.pack.previewed"}},"required":["event_type"]},"then":{"properties":{"event_seq":{"type":"integer","minimum":1},"data":{"$ref":"#/$defs/MemoryPackPreviewedPayload"}}}},
    {"if":{"properties":{"event_type":{"const":"memory.pack.committed"}},"required":["event_type"]},"then":{"properties":{"event_seq":{"type":"integer","minimum":1},"data":{"$ref":"#/$defs/MemoryPackCommittedPayload"}}}}
  ],
  "$defs": {
    "TaskId": {
      "type": "string",
      "pattern": "^task_[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "RunId": {
      "type": "string",
      "pattern": "^run_[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "MessageId": {
      "type": "string",
      "pattern": "^msg_[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "FingerprintId": {
      "type": "string",
      "pattern": "^fp_[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "PlanId": {
      "type": "string",
      "pattern": "^plan_[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "ToolCallId": {
      "type": "string",
      "pattern": "^tool_[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "ToolResultId": {
      "type": "string",
      "pattern": "^toolres_[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "ErrorId": {
      "type": "string",
      "pattern": "^err_[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "Timestamp": {
      "type": "string",
      "format": "date-time",
      "description": "UTC ISO-8601 timestamp with a Z suffix."
    },
    "Domain": {
      "type": "string",
      "enum": [
        "programming_learning",
        "software_development",
        "general_text",
        "other"
      ]
    },
    "ClassificationReasonCode": {
      "type": "string",
      "enum": [
        "code_present",
        "technical_context",
        "debugging_cue",
        "learning_cue",
        "explanation_intent",
        "development_action",
        "deployment_cue",
        "text_task",
        "ambiguous"
      ]
    },
    "TaskType": {
      "type": "string",
      "enum": [
        "debugging_guidance",
        "code_review",
        "code_explanation",
        "code_generation",
        "environment_configuration",
        "general_question",
        "other"
      ]
    },
    "ArtifactType": {
      "type": "string",
      "enum": [
        "source_code",
        "configuration",
        "text",
        "none",
        "other"
      ]
    },
    "ProgrammingLanguage": {
      "type": "string",
      "enum": [
        "python",
        "javascript",
        "typescript",
        "java",
        "c",
        "cpp",
        "rust",
        "go",
        "other",
        "unknown"
      ]
    },
    "AsyncErrorCode": {
      "type": "string",
      "enum": [
        "PROVIDER_TIMEOUT",
        "PROVIDER_ERROR",
        "TOOL_NOT_FOUND",
        "TOOL_INPUT_INVALID",
        "STREAM_INTERRUPTED",
        "RUN_INTERRUPTED"
      ]
    },
    "FeedbackId": {
      "type": "string",
      "pattern": "^feedback_[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "MemoryJobId": {
      "type": "string",
      "pattern": "^job_[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "FeedbackType": {
      "type": "string",
      "enum": [
        "explicit_text",
        "edited_output",
        "rating",
        "accepted",
        "rejected",
        "composite"
      ]
    },
    "SafeToolArgsSummary": {
      "type": "object",
      "description": "Metadata only; source code is forbidden.",
      "properties": {
        "language": {
          "type": "string",
          "const": "python"
        },
        "code_source": {
          "type": "string",
          "enum": [
            "fenced_python",
            "whole_task_valid_python"
          ]
        },
        "code_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 102400
        }
      },
      "required": [
        "language",
        "code_source",
        "code_bytes"
      ],
      "additionalProperties": false
    },
    "TaskCreatedPayload": {
      "type": "object",
      "properties": {
        "task_status": {
          "type": "string",
          "const": "active"
        },
        "run_status": {
          "type": "string",
          "const": "queued"
        }
      },
      "required": [
        "task_status",
        "run_status"
      ],
      "additionalProperties": false
    },
    "TaskStagePayload": {
      "type": "object",
      "properties": {
        "stage": {
          "type": "string",
          "enum": [
            "fingerprinting",
            "retrieving",
            "planning",
            "tool_running",
            "generating",
            "failed"
          ]
        },
        "progress_label": {
          "type": "string",
          "enum": [
            "fingerprinting_task",
            "retrieving_memory",
            "publishing_plan",
            "running_static_tool",
            "generating_answer",
            "run_failed"
          ]
        }
      },
      "required": [
        "stage",
        "progress_label"
      ],
      "additionalProperties": false
    },
    "TaskFingerprintedPayload": {
      "type": "object",
      "description": "Safe enum summary only; semantic_query and task/source text are forbidden.",
      "properties": {
        "fingerprint_id": {
          "$ref": "#/$defs/FingerprintId"
        },
        "domain": {
          "$ref": "#/$defs/Domain"
        },
        "classification_source": {
          "type": "string",
          "const": "auto_rule_v1"
        },
        "classification_confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "classification_reasons": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ClassificationReasonCode"
          },
          "maxItems": 5,
          "uniqueItems": true
        },
        "task_type": {
          "$ref": "#/$defs/TaskType"
        },
        "artifact_type": {
          "$ref": "#/$defs/ArtifactType"
        },
        "language": {
          "$ref": "#/$defs/ProgrammingLanguage"
        }
      },
      "required": [
        "fingerprint_id",
        "domain",
        "classification_source",
        "classification_confidence",
        "classification_reasons",
        "task_type",
        "artifact_type",
        "language"
      ],
      "additionalProperties": false
    },
    "MemoryRetrievalStartedPayload": {
      "type": "object",
      "description": "Transient retrieval start notification. G3 uses retrieval_mode; G2 used memory_count+summary.",
      "properties": {
        "retrieval_mode": {
          "type": "string",
          "enum": [
            "tfidf",
            "tfidf_degraded"
          ]
        },
        "memory_count": {
          "type": "integer"
        },
        "summary": {
          "type": "string"
        }
      },
      "anyOf": [
        {
          "required": [
            "retrieval_mode"
          ]
        },
        {
          "required": [
            "memory_count",
            "summary"
          ]
        }
      ],
      "additionalProperties": false
    },
    "AgentPlanPublishedPayload": {
      "type": "object",
      "description": "Persistent metadata codes only. Human-readable plan text is read from TaskSnapshot.",
      "properties": {
        "plan_id": {
          "$ref": "#/$defs/PlanId"
        },
        "goal_code": {
          "type": "string",
          "enum": [
            "analyze_code",
            "answer_question",
            "explain_concept",
            "other"
          ]
        },
        "memory_summary_code": {
          "type": "string",
          "enum": [
            "no_memory_selected",
            "memory_selected"
          ]
        },
        "next_action_code": {
          "type": "string",
          "enum": [
            "python_ast_check",
            "generate_directly"
          ]
        }
      },
      "required": [
        "plan_id",
        "goal_code",
        "memory_summary_code",
        "next_action_code"
      ],
      "additionalProperties": false
    },
    "ToolCalledPayload": {
      "type": "object",
      "properties": {
        "tool_call_id": {
          "$ref": "#/$defs/ToolCallId"
        },
        "tool_name": {
          "type": "string",
          "const": "python_ast_check"
        },
        "reason_code": {
          "type": "string",
          "const": "python_code_detected"
        },
        "args_summary": {
          "$ref": "#/$defs/SafeToolArgsSummary"
        }
      },
      "required": [
        "tool_call_id",
        "tool_name",
        "reason_code",
        "args_summary"
      ],
      "additionalProperties": false
    },
    "ToolResultPayload": {
      "type": "object",
      "description": "Metadata only. AST details are available through TaskSnapshot by result_ref.",
      "properties": {
        "tool_call_id": {
          "$ref": "#/$defs/ToolCallId"
        },
        "tool_name": {
          "type": "string",
          "const": "python_ast_check"
        },
        "status": {
          "type": "string",
          "enum": [
            "succeeded",
            "failed"
          ]
        },
        "latency_ms": {
          "type": "number",
          "minimum": 0
        },
        "result_ref": {
          "oneOf": [
            {
              "$ref": "#/$defs/ToolResultId"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "tool_call_id",
        "tool_name",
        "status",
        "latency_ms",
        "result_ref"
      ],
      "additionalProperties": false
    },
    "AgentChunkPayload": {
      "type": "object",
      "properties": {
        "run_id": {
          "$ref": "#/$defs/RunId"
        },
        "chunk_seq": {
          "type": "integer",
          "minimum": 1
        },
        "start_offset": {
          "type": "integer",
          "minimum": 0,
          "maximum": 262144
        },
        "end_offset": {
          "type": "integer",
          "minimum": 1,
          "maximum": 262144
        },
        "offset_unit": {
          "type": "string",
          "const": "utf8_bytes"
        },
        "delta": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32768
        }
      },
      "required": [
        "run_id",
        "chunk_seq",
        "start_offset",
        "end_offset",
        "offset_unit",
        "delta"
      ],
      "additionalProperties": false,
      "description": "The data.run_id must equal the envelope run_id. Contract tests also assert end_offset = start_offset + UTF-8 byte length(delta)."
    },
    "RunMetricsPayload": {
      "type": "object",
      "properties": {
        "provider": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "model": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "provider_mode": {
          "type": "string",
          "enum": [
            "mock",
            "real"
          ]
        },
        "first_token_ms": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "total_ms": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "prompt_tokens": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "output_tokens": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "token_source": {
          "type": "string",
          "enum": [
            "actual",
            "unavailable",
            "mock"
          ]
        }
      },
      "required": [
        "provider",
        "model",
        "provider_mode",
        "first_token_ms",
        "total_ms",
        "prompt_tokens",
        "output_tokens",
        "token_source"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "token_source": {
                "const": "unavailable"
              }
            },
            "required": [
              "token_source"
            ]
          },
          "then": {
            "properties": {
              "prompt_tokens": {
                "type": "null"
              },
              "output_tokens": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "token_source": {
                "enum": [
                  "actual",
                  "mock"
                ]
              }
            },
            "required": [
              "token_source"
            ]
          },
          "then": {
            "properties": {
              "prompt_tokens": {
                "type": "integer",
                "minimum": 0
              },
              "output_tokens": {
                "type": "integer",
                "minimum": 0
              }
            }
          }
        }
      ]
    },
    "RunCompletedPayload": {
      "type": "object",
      "properties": {
        "status": {
          "type": "string",
          "const": "succeeded"
        },
        "message_id": {
          "$ref": "#/$defs/MessageId"
        },
        "end_offset": {
          "type": "integer",
          "minimum": 0,
          "maximum": 262144
        },
        "offset_unit": {
          "type": "string",
          "const": "utf8_bytes"
        }
      },
      "required": [
        "status",
        "message_id",
        "end_offset",
        "offset_unit"
      ],
      "additionalProperties": false
    },
    "RunFailedPayload": {
      "type": "object",
      "description": "Metadata only; partial_output is forbidden and must be obtained from TaskSnapshot.",
      "properties": {
        "status": {
          "type": "string",
          "const": "failed"
        },
        "error_code": {
          "$ref": "#/$defs/AsyncErrorCode"
        },
        "retryable": {
          "type": "boolean"
        },
        "partial_message_id": {
          "oneOf": [
            {
              "$ref": "#/$defs/MessageId"
            },
            {
              "type": "null"
            }
          ]
        },
        "end_offset": {
          "type": "integer",
          "minimum": 0,
          "maximum": 262144
        },
        "offset_unit": {
          "type": "string",
          "const": "utf8_bytes"
        }
      },
      "required": [
        "status",
        "error_code",
        "retryable",
        "partial_message_id",
        "end_offset",
        "offset_unit"
      ],
      "additionalProperties": false
    },
    "ErrorPayload": {
      "type": "object",
      "properties": {
        "error_id": {
          "$ref": "#/$defs/ErrorId"
        },
        "code": {
          "$ref": "#/$defs/AsyncErrorCode"
        },
        "message": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240,
          "description": "Curated public message only; credentials, headers, and upstream bodies are forbidden."
        },
        "retryable": {
          "type": "boolean"
        }
      },
      "required": [
        "error_id",
        "code",
        "message",
        "retryable"
      ],
      "additionalProperties": false
    },
    "StreamDonePayload": {
      "type": "object",
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "succeeded",
            "failed"
          ]
        },
        "final_snapshot_required": {
          "type": "boolean",
          "const": true
        }
      },
      "required": [
        "status",
        "final_snapshot_required"
      ],
      "additionalProperties": false
    },
    "FeedbackRecordedPayload": {
      "type": "object",
      "description": "Metadata only. Feedback bodies are forbidden.",
      "properties": {
        "feedback_id": {
          "$ref": "#/$defs/FeedbackId"
        },
        "memory_job_id": {
          "$ref": "#/$defs/MemoryJobId"
        },
        "feedback_type": {
          "$ref": "#/$defs/FeedbackType"
        }
      },
      "required": [
        "feedback_id",
        "memory_job_id",
        "feedback_type"
      ],
      "additionalProperties": false
    },
    "MemoryId": {
      "type": "string",
      "pattern": "^mem_[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "MemoryVersionId": {
      "type": "string",
      "pattern": "^memver_[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "EvidenceId": {
      "type": "string",
      "pattern": "^evidence_[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "MemoryJobStage": {
      "type": "string",
      "enum": [
        "queued",
        "diffing",
        "classifying_durability",
        "extracting",
        "validating",
        "admitting",
        "done",
        "failed"
      ]
    },
    "Disposition": {
      "type": "string",
      "enum": [
        "candidate_created",
        "episode_only",
        "reinforce_usage_only",
        "no_memory",
        "failed"
      ]
    },
    "MemoryJobErrorCode": {
      "type": "string",
      "enum": [
        "MEMORY_JOB_INTERRUPTED",
        "MEMORY_JSON_INVALID",
        "MEMORY_SCHEMA_INVALID",
        "MEMORY_REPAIR_FAILED",
        "MEMORY_PROVIDER_ERROR",
        "MEMORY_PROVIDER_TIMEOUT",
        "MEMORY_EVIDENCE_NOT_FOUND",
        "MEMORY_NO_REUSABLE_CONTENT",
        "MEMORY_SCOPE_TOO_BROAD"
      ]
    },
    "MemoryExtractionStagePayload": {
      "type": "object",
      "description": "Observable extraction stage. Metadata only; no feedback, rule, or diff text.",
      "properties": {
        "memory_job_id": {
          "$ref": "#/$defs/MemoryJobId"
        },
        "stage": {
          "$ref": "#/$defs/MemoryJobStage"
        }
      },
      "required": [
        "memory_job_id",
        "stage"
      ],
      "additionalProperties": false
    },
    "MemoryCandidateCreatedPayload": {
      "type": "object",
      "description": "A candidate card and its evidence were created. ordinal is 0..2 in creation order.",
      "properties": {
        "memory_job_id": {
          "$ref": "#/$defs/MemoryJobId"
        },
        "memory_id": {
          "$ref": "#/$defs/MemoryId"
        },
        "evidence_id": {
          "$ref": "#/$defs/EvidenceId"
        },
        "ordinal": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2
        }
      },
      "required": [
        "memory_job_id",
        "memory_id",
        "evidence_id",
        "ordinal"
      ],
      "additionalProperties": false
    },
    "MemoryAdmissionResolvedPayload": {
      "type": "object",
      "description": "A resolve action completed. memory_version_id is present only when a v1 was created (accept/edit_accept).",
      "properties": {
        "memory_id": {
          "$ref": "#/$defs/MemoryId"
        },
        "old_status": {
          "type": "string",
          "enum": [
            "candidate",
            "active",
            "rejected",
            "conflicted",
            "paused",
            "superseded",
            "merged",
            "archived",
            "deleted"
          ]
        },
        "new_status": {
          "type": "string",
          "enum": [
            "candidate",
            "active",
            "rejected",
            "conflicted",
            "paused",
            "superseded",
            "merged",
            "archived",
            "deleted"
          ]
        },
        "memory_version_id": {
          "oneOf": [
            {
              "$ref": "#/$defs/MemoryVersionId"
            },
            {
              "type": "null"
            }
          ]
        },
        "disposition": {
          "$ref": "#/$defs/Disposition"
        }
      },
      "required": [
        "memory_id",
        "old_status",
        "new_status",
        "memory_version_id",
        "disposition"
      ],
      "additionalProperties": false
    },
    "MemoryJobFailedPayload": {
      "type": "object",
      "description": "The job failed at the given stage with a controlled error code.",
      "properties": {
        "memory_job_id": {
          "$ref": "#/$defs/MemoryJobId"
        },
        "stage": {
          "$ref": "#/$defs/MemoryJobStage"
        },
        "error_code": {
          "$ref": "#/$defs/MemoryJobErrorCode"
        },
        "retryable": {
          "type": "boolean"
        }
      },
      "required": [
        "memory_job_id",
        "stage",
        "error_code",
        "retryable"
      ],
      "additionalProperties": false
    },
    "MemoryRetrievalCompletedPayload": {
      "type": "object",
      "description": "Retrieval completed: counts, threshold, timing, and token estimates.",
      "properties": {
        "trace_id": {
          "$ref": "#/$defs/RetrievalTraceId"
        },
        "mode": {
          "type": "string",
          "enum": [
            "tfidf",
            "tfidf_degraded"
          ]
        },
        "algorithm_version": {
          "type": "string",
          "const": "char_tfidf_v1"
        },
        "candidate_count": {
          "type": "integer",
          "minimum": 0
        },
        "retrieved_count": {
          "type": "integer",
          "minimum": 0
        },
        "selected_count": {
          "type": "integer",
          "minimum": 0
        },
        "injected_count": {
          "type": "integer",
          "minimum": 0
        },
        "threshold": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "top_k": {
          "type": "integer",
          "minimum": 1
        },
        "retrieval_ms": {
          "type": "integer",
          "minimum": 0
        },
        "memory_chars": {
          "type": "integer",
          "minimum": 0
        },
        "estimated_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "prompt_section_hash": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "trace_id",
        "mode",
        "algorithm_version",
        "candidate_count",
        "retrieved_count",
        "selected_count",
        "injected_count",
        "threshold",
        "top_k",
        "retrieval_ms",
        "memory_chars",
        "estimated_tokens",
        "prompt_section_hash"
      ],
      "additionalProperties": false
    },
    "MemoryInjectedPayload": {
      "type": "object",
      "description": "One injected memory receipt per selected card.",
      "properties": {
        "usage_id": {
          "$ref": "#/$defs/UsageId"
        },
        "trace_id": {
          "$ref": "#/$defs/RetrievalTraceId"
        },
        "memory_id": {
          "$ref": "#/$defs/MemoryId"
        },
        "memory_version_id": {
          "$ref": "#/$defs/MemoryVersionId"
        },
        "rank": {
          "type": "integer",
          "minimum": 1
        },
        "estimated_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "prompt_section_hash": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "usage_id",
        "trace_id",
        "memory_id",
        "memory_version_id",
        "rank",
        "estimated_tokens",
        "prompt_section_hash"
      ],
      "additionalProperties": false
    },
    "MemoryUsageVerifiedPayload": {
      "type": "object",
      "description": "Verification result for an injected memory receipt.",
      "properties": {
        "usage_id": {
          "$ref": "#/$defs/UsageId"
        },
        "memory_id": {
          "$ref": "#/$defs/MemoryId"
        },
        "memory_version_id": {
          "$ref": "#/$defs/MemoryVersionId"
        },
        "verification_status": {
          "type": "string",
          "enum": [
            "pending",
            "applied",
            "violated",
            "not_observable",
            "unknown"
          ]
        },
        "verification_method": {
          "type": "string",
          "enum": [
            "exact_substring",
            "structured_provider"
          ]
        },
        "evidence_present": {
          "type": "boolean"
        }
      },
      "required": [
        "usage_id",
        "memory_id",
        "memory_version_id",
        "verification_status",
        "verification_method",
        "evidence_present"
      ],
      "additionalProperties": false
    },
    "MemoryUsageFeedbackRecordedPayload": {
      "type": "object",
      "description": "User feedback on a memory usage receipt.",
      "properties": {
        "usage_id": {
          "$ref": "#/$defs/UsageId"
        },
        "memory_id": {
          "$ref": "#/$defs/MemoryId"
        },
        "user_effect": {
          "type": "string",
          "enum": [
            "helpful",
            "harmful",
            "stale"
          ]
        }
      },
      "required": [
        "usage_id",
        "memory_id",
        "user_effect"
      ],
      "additionalProperties": false
    },
    "TaskDeletedPayload": {
      "type":"object","additionalProperties":false,
      "required":["task_id","memory_policy","affected_card_count"],
      "properties":{"task_id":{"$ref":"#/$defs/TaskId"},"memory_policy":{"const":"preserve_and_mark_evidence_missing"},"affected_card_count":{"type":"integer","minimum":0}}
    },
    "MemoryLifecyclePayload": {
      "type":"object","additionalProperties":false,
      "required":["memory_id","action","old_status","new_status","version_id"],
      "properties":{"memory_id":{"$ref":"#/$defs/MemoryId"},"action":{"enum":["edit","pause","resume","archive","restore","permanent_delete"]},"old_status":{"type":"string"},"new_status":{"type":"string"},"version_id":{"anyOf":[{"$ref":"#/$defs/MemoryVersionId"},{"type":"null"}]}}
    },
    "MemoryConflictDetectedPayload": {
      "type":"object","additionalProperties":false,
      "required":["relation_id","left_memory_id","right_memory_id","status"],
      "properties":{"relation_id":{"$ref":"#/$defs/RelationId"},"left_memory_id":{"$ref":"#/$defs/MemoryId"},"right_memory_id":{"$ref":"#/$defs/MemoryId"},"status":{"const":"unresolved"}}
    },
    "MemoryConflictResolvedPayload": {
      "type":"object","additionalProperties":false,
      "required":["relation_id","action","resolution_memory_id","status"],
      "properties":{"relation_id":{"$ref":"#/$defs/RelationId"},"action":{"enum":["prefer","separate_scopes","merge","pause_both"]},"resolution_memory_id":{"anyOf":[{"$ref":"#/$defs/MemoryId"},{"type":"null"}]},"status":{"const":"resolved"}}
    },
    "MemoryPackPreviewedPayload": {
      "type":"object","additionalProperties":false,
      "required":["batch_id","legal_new","duplicate","potential_conflict","suspicious","expires_at"],
      "properties":{"batch_id":{"$ref":"#/$defs/ImportBatchId"},"legal_new":{"type":"integer","minimum":0},"duplicate":{"type":"integer","minimum":0},"potential_conflict":{"type":"integer","minimum":0},"suspicious":{"type":"integer","minimum":0},"expires_at":{"$ref":"#/$defs/Timestamp"}}
    },
    "MemoryPackCommittedPayload": {
      "type":"object","additionalProperties":false,
      "required":["batch_id","inserted_count","skipped_count"],
      "properties":{"batch_id":{"$ref":"#/$defs/ImportBatchId"},"inserted_count":{"type":"integer","minimum":0},"skipped_count":{"type":"integer","minimum":0}}
    },
    "RelationId":{"type":"string","pattern":"^rel_[0-9A-HJKMNP-TV-Z]{26}$"},
    "ImportBatchId":{"type":"string","pattern":"^batch_[0-9A-HJKMNP-TV-Z]{26}$"},
    "RetrievalTraceId": {
      "type": "string",
      "pattern": "^trace_[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "UsageId": {
      "type": "string",
      "pattern": "^usage_[0-9A-HJKMNP-TV-Z]{26}$"
    }
  }
}
