{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://memtrace.local/contracts/schemas/events.schema.json",
  "title": "MemTrace G0 SSE data envelope",
  "description": "Normative schema for the JSON in each SSE data field. The wire event value equals event_type. Persistent events have an integer event_seq and matching SSE id; transient events have event_seq null and omit the SSE id line.",
  "type": "object",
  "properties": {
    "event_version": {
      "type": "string",
      "const": "1.0"
    },
    "event_type": {
      "type": "string",
      "enum": [
        "task.created",
        "task.stage",
        "task.fingerprinted",
        "memory.retrieval.started",
        "agent.plan.published",
        "tool.called",
        "tool.result",
        "agent.chunk",
        "run.metrics",
        "run.completed",
        "run.failed",
        "error",
        "stream.done",
        "feedback.recorded"
      ]
    },
    "event_seq": {
      "type": ["integer", "null"],
      "minimum": 1
    },
    "task_id": {"$ref": "#/$defs/TaskId"},
    "run_id": {"$ref": "#/$defs/RunId"},
    "at": {"$ref": "#/$defs/Timestamp"},
    "data": {"type": "object"}
  },
  "required": ["event_version", "event_type", "event_seq", "task_id", "run_id", "at", "data"],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {"properties": {"event_type": {"const": "task.created"}}, "required": ["event_type"]},
      "then": {"properties": {"event_seq": {"type": "integer", "minimum": 1}, "data": {"$ref": "#/$defs/TaskCreatedPayload"}}}
    },
    {
      "if": {"properties": {"event_type": {"const": "task.stage"}}, "required": ["event_type"]},
      "then": {"properties": {"event_seq": {"type": "integer", "minimum": 1}, "data": {"$ref": "#/$defs/TaskStagePayload"}}}
    },
    {
      "if": {"properties": {"event_type": {"const": "task.fingerprinted"}}, "required": ["event_type"]},
      "then": {"properties": {"event_seq": {"type": "integer", "minimum": 1}, "data": {"$ref": "#/$defs/TaskFingerprintedPayload"}}}
    },
    {
      "if": {"properties": {"event_type": {"const": "memory.retrieval.started"}}, "required": ["event_type"]},
      "then": {"properties": {"event_seq": {"type": "null"}, "data": {"$ref": "#/$defs/MemoryRetrievalStartedPayload"}}}
    },
    {
      "if": {"properties": {"event_type": {"const": "agent.plan.published"}}, "required": ["event_type"]},
      "then": {"properties": {"event_seq": {"type": "integer", "minimum": 1}, "data": {"$ref": "#/$defs/AgentPlanPublishedPayload"}}}
    },
    {
      "if": {"properties": {"event_type": {"const": "tool.called"}}, "required": ["event_type"]},
      "then": {"properties": {"event_seq": {"type": "integer", "minimum": 1}, "data": {"$ref": "#/$defs/ToolCalledPayload"}}}
    },
    {
      "if": {"properties": {"event_type": {"const": "tool.result"}}, "required": ["event_type"]},
      "then": {"properties": {"event_seq": {"type": "integer", "minimum": 1}, "data": {"$ref": "#/$defs/ToolResultPayload"}}}
    },
    {
      "if": {"properties": {"event_type": {"const": "agent.chunk"}}, "required": ["event_type"]},
      "then": {"properties": {"event_seq": {"type": "null"}, "data": {"$ref": "#/$defs/AgentChunkPayload"}}}
    },
    {
      "if": {"properties": {"event_type": {"const": "run.metrics"}}, "required": ["event_type"]},
      "then": {"properties": {"event_seq": {"type": "integer", "minimum": 1}, "data": {"$ref": "#/$defs/RunMetricsPayload"}}}
    },
    {
      "if": {"properties": {"event_type": {"const": "run.completed"}}, "required": ["event_type"]},
      "then": {"properties": {"event_seq": {"type": "integer", "minimum": 1}, "data": {"$ref": "#/$defs/RunCompletedPayload"}}}
    },
    {
      "if": {"properties": {"event_type": {"const": "run.failed"}}, "required": ["event_type"]},
      "then": {"properties": {"event_seq": {"type": "integer", "minimum": 1}, "data": {"$ref": "#/$defs/RunFailedPayload"}}}
    },
    {
      "if": {"properties": {"event_type": {"const": "error"}}, "required": ["event_type"]},
      "then": {"properties": {"event_seq": {"type": "integer", "minimum": 1}, "data": {"$ref": "#/$defs/ErrorPayload"}}}
    },
    {
      "if": {"properties": {"event_type": {"const": "stream.done"}}, "required": ["event_type"]},
      "then": {"properties": {"event_seq": {"type": "integer", "minimum": 1}, "data": {"$ref": "#/$defs/StreamDonePayload"}}}
    },
    {
      "if": {"properties": {"event_type": {"const": "feedback.recorded"}}, "required": ["event_type"]},
      "then": {"properties": {"event_seq": {"type": "integer", "minimum": 1}, "data": {"$ref": "#/$defs/FeedbackRecordedPayload"}}}
    }
  ],
  "$defs": {
    "TaskId": {
      "type": "string",
      "pattern": "^task_[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "RunId": {
      "type": "string",
      "pattern": "^run_[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "MessageId": {
      "type": "string",
      "pattern": "^msg_[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "FingerprintId": {
      "type": "string",
      "pattern": "^fp_[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "PlanId": {
      "type": "string",
      "pattern": "^plan_[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "ToolCallId": {
      "type": "string",
      "pattern": "^tool_[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "ToolResultId": {
      "type": "string",
      "pattern": "^toolres_[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "ErrorId": {
      "type": "string",
      "pattern": "^err_[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "Timestamp": {
      "type": "string",
      "format": "date-time",
      "description": "UTC ISO-8601 timestamp with a Z suffix."
    },
    "Domain": {
      "type": "string",
      "enum": ["programming_learning", "software_development", "general_text", "other"]
    },
    "ClassificationReasonCode": {
      "type": "string",
      "enum": ["code_present", "technical_context", "debugging_cue", "learning_cue", "explanation_intent", "development_action", "deployment_cue", "text_task", "ambiguous"]
    },
    "TaskType": {
      "type": "string",
      "enum": ["debugging_guidance", "code_review", "code_explanation", "code_generation", "environment_configuration", "general_question", "other"]
    },
    "ArtifactType": {
      "type": "string",
      "enum": ["source_code", "configuration", "text", "none", "other"]
    },
    "ProgrammingLanguage": {
      "type": "string",
      "enum": ["python", "javascript", "typescript", "java", "c", "cpp", "rust", "go", "other", "unknown"]
    },
    "AsyncErrorCode": {
      "type": "string",
      "enum": ["PROVIDER_TIMEOUT", "PROVIDER_ERROR", "TOOL_NOT_FOUND", "TOOL_INPUT_INVALID", "STREAM_INTERRUPTED", "RUN_INTERRUPTED"]
    },
    "FeedbackId": {
      "type": "string",
      "pattern": "^feedback_[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "MemoryJobId": {
      "type": "string",
      "pattern": "^job_[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "FeedbackType": {
      "type": "string",
      "enum": ["explicit_text", "edited_output", "rating", "accepted", "rejected", "composite"]
    },
    "SafeToolArgsSummary": {
      "type": "object",
      "description": "Metadata only; source code is forbidden.",
      "properties": {
        "language": {"type": "string", "const": "python"},
        "code_source": {"type": "string", "enum": ["fenced_python", "whole_task_valid_python"]},
        "code_bytes": {"type": "integer", "minimum": 1, "maximum": 102400}
      },
      "required": ["language", "code_source", "code_bytes"],
      "additionalProperties": false
    },
    "TaskCreatedPayload": {
      "type": "object",
      "properties": {
        "task_status": {"type": "string", "const": "active"},
        "run_status": {"type": "string", "const": "queued"}
      },
      "required": ["task_status", "run_status"],
      "additionalProperties": false
    },
    "TaskStagePayload": {
      "type": "object",
      "properties": {
        "stage": {
          "type": "string",
          "enum": ["fingerprinting", "retrieving", "planning", "tool_running", "generating", "failed"]
        },
        "progress_label": {
          "type": "string",
          "enum": ["fingerprinting_task", "retrieving_memory", "publishing_plan", "running_static_tool", "generating_answer", "run_failed"]
        }
      },
      "required": ["stage", "progress_label"],
      "additionalProperties": false
    },
    "TaskFingerprintedPayload": {
      "type": "object",
      "description": "Safe enum summary only; semantic_query and task/source text are forbidden.",
      "properties": {
        "fingerprint_id": {"$ref": "#/$defs/FingerprintId"},
        "domain": {"$ref": "#/$defs/Domain"},
        "classification_source": {"type": "string", "const": "auto_rule_v1"},
        "classification_confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "classification_reasons": {
          "type": "array",
          "items": {"$ref": "#/$defs/ClassificationReasonCode"},
          "maxItems": 5,
          "uniqueItems": true
        },
        "task_type": {"$ref": "#/$defs/TaskType"},
        "artifact_type": {"$ref": "#/$defs/ArtifactType"},
        "language": {"$ref": "#/$defs/ProgrammingLanguage"}
      },
      "required": ["fingerprint_id", "domain", "classification_source", "classification_confidence", "classification_reasons", "task_type", "artifact_type", "language"],
      "additionalProperties": false
    },
    "MemoryRetrievalStartedPayload": {
      "type": "object",
      "properties": {
        "memory_count": {"type": "integer", "const": 0},
        "summary": {"type": "string", "const": "no_long_term_memory_day2"}
      },
      "required": ["memory_count", "summary"],
      "additionalProperties": false
    },
    "AgentPlanPublishedPayload": {
      "type": "object",
      "description": "Persistent metadata codes only. Human-readable plan text is read from TaskSnapshot.",
      "properties": {
        "plan_id": {"$ref": "#/$defs/PlanId"},
        "goal_code": {"type": "string", "enum": ["analyze_code", "answer_question", "explain_concept", "other"]},
        "memory_summary_code": {"type": "string", "const": "no_long_term_memory_day2"},
        "next_action_code": {"type": "string", "enum": ["python_ast_check", "generate_directly"]}
      },
      "required": ["plan_id", "goal_code", "memory_summary_code", "next_action_code"],
      "additionalProperties": false
    },
    "ToolCalledPayload": {
      "type": "object",
      "properties": {
        "tool_call_id": {"$ref": "#/$defs/ToolCallId"},
        "tool_name": {"type": "string", "const": "python_ast_check"},
        "reason_code": {"type": "string", "const": "python_code_detected"},
        "args_summary": {"$ref": "#/$defs/SafeToolArgsSummary"}
      },
      "required": ["tool_call_id", "tool_name", "reason_code", "args_summary"],
      "additionalProperties": false
    },
    "ToolResultPayload": {
      "type": "object",
      "description": "Metadata only. AST details are available through TaskSnapshot by result_ref.",
      "properties": {
        "tool_call_id": {"$ref": "#/$defs/ToolCallId"},
        "tool_name": {"type": "string", "const": "python_ast_check"},
        "status": {"type": "string", "enum": ["succeeded", "failed"]},
        "latency_ms": {"type": "number", "minimum": 0},
        "result_ref": {
          "oneOf": [
            {"$ref": "#/$defs/ToolResultId"},
            {"type": "null"}
          ]
        }
      },
      "required": ["tool_call_id", "tool_name", "status", "latency_ms", "result_ref"],
      "additionalProperties": false
    },
    "AgentChunkPayload": {
      "type": "object",
      "properties": {
        "run_id": {"$ref": "#/$defs/RunId"},
        "chunk_seq": {"type": "integer", "minimum": 1},
        "start_offset": {"type": "integer", "minimum": 0, "maximum": 262144},
        "end_offset": {"type": "integer", "minimum": 1, "maximum": 262144},
        "offset_unit": {"type": "string", "const": "utf8_bytes"},
        "delta": {"type": "string", "minLength": 1, "maxLength": 32768}
      },
      "required": ["run_id", "chunk_seq", "start_offset", "end_offset", "offset_unit", "delta"],
      "additionalProperties": false,
      "description": "The data.run_id must equal the envelope run_id. Contract tests also assert end_offset = start_offset + UTF-8 byte length(delta)."
    },
    "RunMetricsPayload": {
      "type": "object",
      "properties": {
        "provider": {"type": "string", "minLength": 1, "maxLength": 64},
        "model": {"type": "string", "minLength": 1, "maxLength": 128},
        "provider_mode": {"type": "string", "enum": ["mock", "real"]},
        "first_token_ms": {"type": ["number", "null"], "minimum": 0},
        "total_ms": {"type": ["number", "null"], "minimum": 0},
        "prompt_tokens": {"type": ["integer", "null"], "minimum": 0},
        "output_tokens": {"type": ["integer", "null"], "minimum": 0},
        "token_source": {"type": "string", "enum": ["actual", "unavailable", "mock"]}
      },
      "required": ["provider", "model", "provider_mode", "first_token_ms", "total_ms", "prompt_tokens", "output_tokens", "token_source"],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {"properties": {"token_source": {"const": "unavailable"}}, "required": ["token_source"]},
          "then": {"properties": {"prompt_tokens": {"type": "null"}, "output_tokens": {"type": "null"}}}
        },
        {
          "if": {"properties": {"token_source": {"enum": ["actual", "mock"]}}, "required": ["token_source"]},
          "then": {"properties": {"prompt_tokens": {"type": "integer", "minimum": 0}, "output_tokens": {"type": "integer", "minimum": 0}}}
        }
      ]
    },
    "RunCompletedPayload": {
      "type": "object",
      "properties": {
        "status": {"type": "string", "const": "succeeded"},
        "message_id": {"$ref": "#/$defs/MessageId"},
        "end_offset": {"type": "integer", "minimum": 0, "maximum": 262144},
        "offset_unit": {"type": "string", "const": "utf8_bytes"}
      },
      "required": ["status", "message_id", "end_offset", "offset_unit"],
      "additionalProperties": false
    },
    "RunFailedPayload": {
      "type": "object",
      "description": "Metadata only; partial_output is forbidden and must be obtained from TaskSnapshot.",
      "properties": {
        "status": {"type": "string", "const": "failed"},
        "error_code": {"$ref": "#/$defs/AsyncErrorCode"},
        "retryable": {"type": "boolean"},
        "partial_message_id": {
          "oneOf": [
            {"$ref": "#/$defs/MessageId"},
            {"type": "null"}
          ]
        },
        "end_offset": {"type": "integer", "minimum": 0, "maximum": 262144},
        "offset_unit": {"type": "string", "const": "utf8_bytes"}
      },
      "required": ["status", "error_code", "retryable", "partial_message_id", "end_offset", "offset_unit"],
      "additionalProperties": false
    },
    "ErrorPayload": {
      "type": "object",
      "properties": {
        "error_id": {"$ref": "#/$defs/ErrorId"},
        "code": {"$ref": "#/$defs/AsyncErrorCode"},
        "message": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240,
          "description": "Curated public message only; credentials, headers, and upstream bodies are forbidden."
        },
        "retryable": {"type": "boolean"}
      },
      "required": ["error_id", "code", "message", "retryable"],
      "additionalProperties": false
    },
    "StreamDonePayload": {
      "type": "object",
      "properties": {
        "status": {"type": "string", "enum": ["succeeded", "failed"]},
        "final_snapshot_required": {"type": "boolean", "const": true}
      },
      "required": ["status", "final_snapshot_required"],
      "additionalProperties": false
    },
    "FeedbackRecordedPayload": {
      "type": "object",
      "description": "Metadata only. Feedback bodies are forbidden.",
      "properties": {
        "feedback_id": {"$ref": "#/$defs/FeedbackId"},
        "memory_job_id": {"$ref": "#/$defs/MemoryJobId"},
        "feedback_type": {"$ref": "#/$defs/FeedbackType"}
      },
      "required": ["feedback_id", "memory_job_id", "feedback_type"],
      "additionalProperties": false
    }
  }
}
