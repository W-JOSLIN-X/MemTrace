# MemTrace Day 7 local configuration. Copy to .env; never commit real secrets.
APP_NAME=MemTrace API
APP_ENV=development
APP_VERSION=0.1.1
APP_REVISION=development
LOG_LEVEL=INFO

# Real semantic runs require MOCK_MODE=false and a live-verified DeepSeek model.
# For release Compose, prefer LLM_API_KEY_FILE instead of LLM_API_KEY.
MOCK_MODE=true
LLM_API_KEY=
LLM_API_KEY_FILE=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-v4-flash
PROVIDER_TIMEOUT_SECONDS=60

# Public authentication and browser origin.
# Release must set ALLOW_DEMO_SESSIONS=false and COOKIE_SECURE=true behind HTTPS.
ALLOW_DEMO_SESSIONS=true
PUBLIC_ORIGIN=http://127.0.0.1:8000
PUBLIC_SESSION_HOURS=168
SESSION_SECRET=
SESSION_SECRET_FILE=
COOKIE_SECURE=false
DAILY_REAL_TURN_LIMIT=50
MAX_ACTIVE_TURNS_PER_OWNER=1
MAX_REQUEST_BODY_BYTES=1048576

# Release only: exact Docker bridge gateway used by the host Nginx proxy.
# Wildcards, CIDRs, hostnames, and client-controlled values are rejected.
TRUSTED_PROXY_IPS=

# Frozen Day 7 memory configuration selected by validation_grid_v1.
MEMORY_AUTO_ACTIVATE_CONFIDENCE=0.85
MEMORY_TOKEN_BUDGET_PER_CARD=100
MEMORY_TOKEN_BUDGET_TOTAL=300
MEMORY_MAX_CANDIDATES=50
MEMORY_TOP_K=5

# Streaming, import, and in-process capacity.
MOCK_CHUNK_DELAY_MS=250
SSE_HEARTBEAT_SECONDS=15
IMPORT_PREVIEW_TTL_SECONDS=1800
MAX_TASKS=100
MAX_SUBSCRIBERS_PER_TASK=8
SUBSCRIBER_QUEUE_SIZE=64

# Relative paths are resolved from the repository root.
MEMTRACE_DATA_DIR=data
MEMTRACE_DATABASE_URL=sqlite:///data/memtrace.sqlite3
MEMTRACE_WEB_DIST=
