# MemTrace local configuration. Copy this file to .env; never commit real secrets.
APP_NAME=MemTrace API
APP_ENV=development
APP_VERSION=0.1.0
LOG_LEVEL=INFO

# true: deterministic local provider; false: configured external provider
MOCK_MODE=true
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-v4-flash
PROVIDER_TIMEOUT_SECONDS=60

# Deterministic Mock streaming and process-local SSE capacity.
MOCK_CHUNK_DELAY_MS=250
SSE_HEARTBEAT_SECONDS=15
MAX_TASKS=100
MAX_SUBSCRIBERS_PER_TASK=8
SUBSCRIBER_QUEUE_SIZE=64

# Relative paths are resolved from the repository root.
MEMTRACE_DATA_DIR=data
MEMTRACE_WEB_DIST=

# Day 2 G1 Database and Demo Session Configuration
MEMTRACE_DATABASE_URL=sqlite:///data/memtrace.sqlite3
SESSION_SECRET=
COOKIE_SECURE=false
