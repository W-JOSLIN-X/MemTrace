# Render __MEMTRACE_DOMAIN__ and __LETSENCRYPT_LIVE_DIR__ before enabling this
# file. This template belongs inside Nginx's http context (for example,
# /etc/nginx/sites-available/memtrace.conf on Ubuntu).

log_format memtrace_metadata escape=json
    '{"time":"$time_iso8601","method":"$request_method","uri":"$uri",'
    '"status":$status,"request_length":$request_length,"bytes_sent":$bytes_sent,'
    '"request_time":$request_time,"upstream_time":"$upstream_response_time"}';

server {
    listen 80;
    listen [::]:80;
    server_name __MEMTRACE_DOMAIN__;

    access_log /var/log/nginx/memtrace_access.log memtrace_metadata;
    error_log /var/log/nginx/memtrace_error.log crit;

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name __MEMTRACE_DOMAIN__;

    ssl_certificate __LETSENCRYPT_LIVE_DIR__/fullchain.pem;
    ssl_certificate_key __LETSENCRYPT_LIVE_DIR__/privkey.pem;

    access_log /var/log/nginx/memtrace_access.log memtrace_metadata;
    # Nginx error entries can contain a request line, including a query. Keep
    # the release error log at critical-only and use application request IDs
    # for ordinary diagnosis.
    error_log /var/log/nginx/memtrace_error.log crit;

    client_max_body_size 1m;

    location / {
        proxy_pass http://127.0.0.1:18070;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Real-IP $remote_addr;
        # Overwrite, never append, so an Internet client cannot inject the
        # identity used by the API's authentication rate limiter.
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header Connection "";

        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 75s;
        proxy_send_timeout 75s;
    }
}
